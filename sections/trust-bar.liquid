{%- comment -%}
  Reasons to buy, right under the drop: shipping, returns, payments, limited pieces.
  "{soglia}" in a title becomes the free shipping threshold set in Theme settings > Carrello.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="trust trust--{{ section.settings.style }}" data-tb="trust">
  <ul class="trust__l">
    {%- for b in section.blocks -%}
      <li class="trust__i rv" {{ b.shopify_attributes }}>
        <span class="trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24">
          {%- case b.settings.icon -%}
            {%- when 'ship' -%}<path d="M2 6h11v10H2zM13 9h4.5l3.5 3.5V16h-8"/><circle cx="6.5" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/>
            {%- when 'return' -%}<path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1L3.5 8.5"/><path d="M3.5 3.5v5h5"/>
            {%- when 'secure' -%}<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14.5v2.5"/>
            {%- when 'limited' -%}<path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/>
            {%- else -%}<path d="M12 21s-7.5-4.6-9.3-9.6C1.5 8 3.6 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8 1.2-1.7 2.8-2.8 4.8-2.8 3.6 0 5.7 3.5 4.5 6.9C19.5 16.4 12 21 12 21z"/>
          {%- endcase -%}
        </svg></span>
        <span class="trust__tx"><b>{{ b.settings.title | replace: '{soglia}', settings.free_shipping | escape }}</b>{%- if b.settings.text != blank -%}<span>{{ b.settings.text | escape }}</span>{%- endif -%}</span>
      </li>
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Perché comprare qui",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "style", "label": "Sfondo", "default": "yellow", "options": [
      { "value": "yellow", "label": "Giallo" },
      { "value": "ink", "label": "Scuro" },
      { "value": "paper", "label": "Carta" }
    ] },
    { "type": "paragraph", "content": "Scrivi solo cose vere per il tuo negozio: spedizioni, resi e pagamenti devono corrispondere alle tue policy." }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Motivo",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icona", "default": "ship", "options": [
          { "value": "ship", "label": "Furgone" },
          { "value": "return", "label": "Reso" },
          { "value": "secure", "label": "Lucchetto" },
          { "value": "limited", "label": "Stella" },
          { "value": "heart", "label": "Cuore" }
        ] },
        { "type": "text", "id": "title", "label": "Titolo", "info": "{soglia} = soglia spedizione gratis delle impostazioni del tema", "default": "Spedizione gratis da {soglia}€" },
        { "type": "text", "id": "text", "label": "Testo", "default": "In tutta Italia" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perché comprare qui",
      "blocks": [
        { "type": "reason", "settings": { "icon": "ship", "title": "Spedizione gratis da {soglia}€", "text": "In tutta Italia" } },
        { "type": "reason", "settings": { "icon": "return", "title": "Reso entro 14 giorni", "text": "Non ti sta? Ce la rimandi" } },
        { "type": "reason", "settings": { "icon": "secure", "title": "Pagamento sicuro", "text": "Checkout protetto" } },
        { "type": "reason", "settings": { "icon": "limited", "title": "Pezzi limitati", "text": "Finiti quelli, finito il drop" } }
      ]
    }
  ]
}
{% endschema %}
