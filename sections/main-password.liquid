<section class="password" data-tb="password">
  <div class="password__center">
    <p class="label">{{ section.settings.kicker | escape }}</p>
    {% render 'badge', class: 'password__badge' %}
    {%- if section.settings.date != blank -%}
      <div class="count" data-countdown="{{ section.settings.date | escape }}">
        <div><b data-u="d">00</b><small>{{ 'countdown.days' | t }}</small></div>
        <div><b data-u="h">00</b><small>{{ 'countdown.hours' | t }}</small></div>
        <div><b data-u="m">00</b><small>{{ 'countdown.minutes' | t }}</small></div>
        <div><b data-u="s">00</b><small>{{ 'countdown.seconds' | t }}</small></div>
      </div>
    {%- endif -%}
    {%- if shop.password_message != blank -%}<p class="password__msg">{{ shop.password_message }}</p>{%- endif -%}
    {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}
    <details class="password__enter">
      <summary class="label">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="nl">
          <input type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.placeholder' | t }}" aria-label="{{ 'password.placeholder' | t }}">
          <button type="submit"><span>{{ 'password.submit' | t }}</span></button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password / pre-drop",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta", "default": "Il prossimo drop sta arrivando" },
    { "type": "text", "id": "date", "label": "Data e ora", "info": "Formato 2026-11-14T18:00:00+01:00", "default": "2026-11-14T18:00:00+01:00" }
  ]
}
{% endschema %}
