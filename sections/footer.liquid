<footer class="ftr" data-tb="footer">
  <div class="ftr__top">
    <div>
      <h2 class="d">{{ section.settings.heading | escape }}</h2>
      <p class="ftr__txt">{{ section.settings.text | escape }}</p>
      {% render 'newsletter-form', form_id: 'FooterNewsletter' %}
    </div>
    <nav class="ftr__links" aria-label="{{ section.settings.menu_1.title | escape }}">
      <span class="label">{{ section.settings.menu_1.title | escape }}</span>
      {%- for link in section.settings.menu_1.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
    </nav>
    <nav class="ftr__links" aria-label="{{ section.settings.menu_2.title | escape }}">
      <span class="label">{{ section.settings.menu_2.title | escape }}</span>
      {%- for link in section.settings.menu_2.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
    </nav>
  </div>
  <div class="ftr__word" aria-hidden="true"><span data-fit>{{ section.settings.wordmark | default: shop.name | escape }}</span></div>
  <div class="ftr__bot">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
    <span>{{ section.settings.tagline | escape }}</span>
    <span class="payments">
      {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endfor -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Entra nel team" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Niente spam. Solo drop, market e qualche video di gente che cade dalla moto." },
    { "type": "link_list", "id": "menu_1", "label": "Menu 1", "default": "main-menu" },
    { "type": "link_list", "id": "menu_2", "label": "Menu 2", "default": "footer" },
    { "type": "text", "id": "wordmark", "label": "Scritta gigante", "default": "TEAM BUTTI" },
    { "type": "text", "id": "tagline", "label": "Frase in basso", "default": "Made between Toscana & SoCal" }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
