{%- liquid
  assign p = section.settings.product
  assign models = section.blocks | where: 'type', 'model'
  assign colorways = section.blocks | where: 'type', 'colorway'
  assign first_cw = colorways.first
  assign size_option = nil
  if p != blank
    for option in p.options_with_values
      assign oname = option.name | downcase
      if oname == section.settings.size_option_name
        assign size_option = option
      endif
    endfor
  endif
-%}
<section class="sec" id="custom" data-tb="customizer">
  <div class="sec__head rv">
    <h2 class="sec__title d grunge">{{ section.settings.title | escape }} <span class="out">{{ section.settings.title_outline | escape }}</span></h2>
    <p class="label sec__aside">{{ section.settings.text | escape }}</p>
  </div>
  <div class="cfg">
    <div class="cfg__stage rv" data-stage{% if first_cw %} style="--cfg-bg: {{ first_cw.settings.bg }}"{% endif %}>
      <span class="cfg__price" data-cfg-price>{% if p != blank %}{{ p.price | money_without_trailing_zeros }}{% endif %}</span>
      <div class="cfg__flip" data-flip><div data-face="front"></div><div data-face="back"></div></div>
      <button class="btn cfg__turn" type="button" data-turn data-h>↻ {{ 'customizer.turn' | t }}</button>
      <span class="cfg__hint">{{ 'customizer.drag' | t }}</span>
    </div>
    <div class="cfg__f rv">
      <div><h3 class="label">01 — {{ 'customizer.model' | t }}</h3>
        <div class="opts" data-models>
          {%- for m in models -%}
            <button type="button" class="opt{% if forloop.first %} on{% endif %}" data-model="{{ m.settings.label | escape }}" data-type="{{ m.settings.type }}" {{ m.shopify_attributes }}>{{ m.settings.label | escape }}</button>
          {%- endfor -%}
        </div>
      </div>
      <div><h3 class="label">02 — {{ 'customizer.colors' | t }}</h3>
        <div class="opts" data-colorways>
          {%- for c in colorways -%}
            {%- capture colors -%}{{ c.settings.base }},{{ c.settings.sleeve }},{{ c.settings.trim }},{{ c.settings.text }}{%- endcapture -%}
            <button type="button" class="sw{% if forloop.first %} on{% endif %}" data-colors="{{ colors }}" data-bg="{{ c.settings.bg }}" data-name="{{ c.settings.name | escape }}" title="{{ c.settings.name | escape }}" aria-label="{{ c.settings.name | escape }}" {{ c.shopify_attributes }}>
              <i style="background:{{ c.settings.base }}"></i><i style="background:{{ c.settings.sleeve }}"></i><i style="background:{{ c.settings.trim }}"></i><i style="background:{{ c.settings.text }}"></i>
            </button>
          {%- endfor -%}
        </div>
      </div>
      <div class="row2">
        <div><h3 class="label"><label for="CfgName-{{ section.id }}">03 — {{ 'customizer.name' | t }}</label></h3><input class="inp" id="CfgName-{{ section.id }}" data-name-input maxlength="10" value="BUTTI" autocomplete="off"></div>
        <div><h3 class="label"><label for="CfgNum-{{ section.id }}">04 — N°</label></h3><input class="inp" id="CfgNum-{{ section.id }}" data-num-input maxlength="2" value="00" inputmode="numeric" autocomplete="off"></div>
      </div>
      <div><h3 class="label">05 — {{ 'customizer.size' | t }}</h3>
        <div class="sizes" data-sizes>
          {%- if size_option -%}
            {%- for v in size_option.values -%}<button type="button" class="size{% if forloop.index == 3 %} on{% endif %}" data-size="{{ v | escape }}">{{ v | escape }}</button>{%- endfor -%}
          {%- else -%}
            {%- assign sizes = 'S,M,L,XL,XXL' | split: ',' -%}
            {%- for v in sizes -%}<button type="button" class="size{% if forloop.index == 3 %} on{% endif %}" data-size="{{ v }}">{{ v }}</button>{%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      {%- if p != blank -%}
        <script type="application/json" data-variants>
          [{%- for v in p.variants -%}{"id":{{ v.id }},"available":{{ v.available | json }},"options":{{ v.options | json }},"price":{{ v.price | money_without_trailing_zeros | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
        </script>
      {%- endif -%}
      <form action="{{ routes.cart_add_url }}" method="post" data-cfg-form>
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
        <input type="hidden" name="properties[Nome]" value="BUTTI" data-prop-name>
        <input type="hidden" name="properties[Numero]" value="00" data-prop-num>
        <input type="hidden" name="properties[Colori]" value="{{ first_cw.settings.name | escape }}" data-prop-colors>
        <button type="submit" class="btn btn--pink btn--block" data-add data-h{% if p == blank %} disabled{% endif %}>
          {%- if p == blank -%}{{ 'customizer.setup' | t }}{%- else -%}{{ 'products.add' | t }}{%- endif -%}
        </button>
        <p class="form-error" data-error hidden></p>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Configuratore maglia",
  "settings": [
    { "type": "text", "id": "title", "label": "Titolo", "default": "Fattela" },
    { "type": "text", "id": "title_outline", "label": "Titolo (contorno)", "default": "tua" },
    { "type": "text", "id": "text", "label": "Testo", "default": "Nome e numero stampati sul retro. Come al Market, ma da casa." },
    { "type": "product", "id": "product", "label": "Prodotto personalizzabile", "info": "Varianti: Modello (uguale alle etichette dei blocchi Modello) × Taglia. Nome, numero e colori arrivano nell'ordine come proprietà." },
    { "type": "text", "id": "size_option_name", "label": "Nome opzione taglia (minuscolo)", "default": "taglia" }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Modello",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Etichetta (= valore variante)", "default": "Hockey" },
        { "type": "select", "id": "type", "label": "Disegno", "default": "hockey", "options": [
          { "value": "hockey", "label": "Hockey" },
          { "value": "mx", "label": "Motocross" },
          { "value": "football", "label": "Football" }
        ] }
      ]
    },
    {
      "type": "colorway",
      "name": "Colori",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "name", "label": "Nome", "default": "Rosa" },
        { "type": "color", "id": "base", "label": "Base", "default": "#FF2E93" },
        { "type": "color", "id": "sleeve", "label": "Maniche", "default": "#0D0D0D" },
        { "type": "color", "id": "trim", "label": "Bordi/strisce", "default": "#F4F1EA" },
        { "type": "color", "id": "text", "label": "Scritte", "default": "#0D0D0D" },
        { "type": "color", "id": "bg", "label": "Sfondo palco", "default": "#FFD400" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Configuratore maglia",
      "blocks": [
        { "type": "model", "settings": { "label": "Hockey", "type": "hockey" } },
        { "type": "model", "settings": { "label": "Motocross", "type": "mx" } },
        { "type": "model", "settings": { "label": "Football", "type": "football" } },
        { "type": "colorway", "settings": { "name": "Rosa" } },
        { "type": "colorway", "settings": { "name": "Kings", "base": "#F4F1EA", "sleeve": "#0D0D0D", "trim": "#9A9A9A", "text": "#0D0D0D", "bg": "#E8E4DA" } },
        { "type": "colorway", "settings": { "name": "USA", "base": "#F4F1EA", "sleeve": "#E3191B", "trim": "#1D3FBF", "text": "#E3191B", "bg": "#FFD400" } },
        { "type": "colorway", "settings": { "name": "Neon", "base": "#39FF14", "sleeve": "#FF2E93", "trim": "#0D0D0D", "text": "#FF2E93", "bg": "#0D0D0D" } }
      ]
    }
  ]
}
{% endschema %}
