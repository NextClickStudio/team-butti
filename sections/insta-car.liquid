{%- comment -%}
  Instagram strip (home page): the mini Team Butti Cadillac drives in towing the Instagram button on a small trailer
  and parks; the button and the car link to the brand's Instagram (Theme settings → Social).
{%- endcomment -%}
{%- assign ig = settings.social_instagram -%}
{%- if ig != blank -%}
{%- liquid
  assign handle = section.settings.handle
  if handle == blank
    assign handle = ig | split: 'instagram.com/' | last | remove: '/' | prepend: '@'
  endif
-%}
<section class="ig ig--{{ section.settings.style }}" data-tb="insta">
  <div class="ig__road" aria-hidden="true"><i></i></div>
  <a class="ig__rig" href="{{ ig }}" target="_blank" rel="noopener" data-ig-rig data-h aria-label="{{ section.settings.label | escape }} {{ handle | escape }}">
    <span class="ig__trailer"><span class="ig__btn">
      <svg class="ig__logo" viewBox="0 0 48 48" focusable="false" aria-hidden="true"><rect x="5" y="5" width="38" height="38" rx="11" fill="none" stroke="currentColor" stroke-width="4.5"/><circle cx="24" cy="24" r="8.5" fill="none" stroke="currentColor" stroke-width="4.5"/><circle cx="35" cy="13" r="2.8" fill="currentColor"/></svg>
      <span class="ig__t"><b class="d">{{ section.settings.label | escape }}</b><span>{{ handle | escape }}</span></span>
    </span><span class="ig__bed" aria-hidden="true"></span><i class="ig__wh" aria-hidden="true"></i><i class="ig__wh ig__wh--2" aria-hidden="true"></i></span>
    <span class="ig__bar" aria-hidden="true"></span>
    <span class="ig__car">{% render 'cadillac', uid: section.id %}</span>
  </a>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Instagram con la Cadillac",
  "settings": [
    { "type": "paragraph", "content": "Il link è quello di Impostazioni tema → Social → Instagram." },
    { "type": "text", "id": "label", "label": "Testo del bottone", "default": "Seguici su Instagram" },
    { "type": "text", "id": "handle", "label": "Nome profilo", "info": "Vuoto = preso dal link (es. @team_butti)" },
    { "type": "select", "id": "style", "label": "Sfondo", "default": "pink", "options": [
      { "value": "pink", "label": "Rosa" },
      { "value": "paper", "label": "Carta" },
      { "value": "ink", "label": "Nero" }
    ] }
  ],
  "presets": [{ "name": "Instagram con la Cadillac" }]
}
{% endschema %}
