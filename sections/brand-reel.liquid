{%- comment -%}
  Brand videos right below the hero. The frame grows to full screen as you scroll,
  with a camcorder HUD (REC, timecode, place, date), clip tabs, comic speech bubbles per clip
  and a shop button that is always on screen.
  Vertical clips (Reels 9:16) get a blurred backdrop so they also work full-width.
  Sticker blocks take turns on the camcorder frame: one at a time on a free spot, never over the bubbles or the HUD (theme.js).
  Live store: hidden until at least one clip has a video. Theme editor: placeholders are shown.
{%- endcomment -%}
{%- liquid
  assign clips = section.blocks | where: 'type', 'clip'
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign has_video = false
  for c in clips
    if c.settings.video != blank
      assign has_video = true
      break
    endif
  endfor
  assign show = has_video
  if request.design_mode or section.settings.show_without_video
    assign show = true
  endif
  assign first = clips.first
-%}
{%- if show and clips.size > 0 -%}
<section class="reel reel--{{ section.settings.style }}" id="video" data-tb="reel" data-auto="{{ section.settings.autoplay_next }}" style="height: {{ section.settings.length }}vh">
  <div class="reel__s">
    <div class="reel__head" aria-hidden="true">
      <span class="reel__big d">{{ section.settings.title_1 | escape }}</span>
      <span class="reel__big reel__big--out d">{{ section.settings.title_2 | escape }}</span>
    </div>
    <div class="reel__frame" data-reel-frame>
      <div class="reel__clips">
        {%- for c in clips -%}
          {%- assign bubbles = c.settings.bubbles | split: '|' -%}
          <div class="reel__clip{% if forloop.first %} on{% endif %}{% if c.settings.video != blank and c.settings.video.aspect_ratio < 1 %} reel__clip--tall{% endif %}" data-clip data-place="{{ c.settings.place | escape }}" data-date="{{ c.settings.date | escape }}" {{ c.shopify_attributes }}>
            {%- if c.settings.video != blank -%}
              {%- if c.settings.video.aspect_ratio < 1 and c.settings.video.preview_image -%}
                <div class="reel__bg" style="background-image: url('{{ c.settings.video.preview_image | image_url: width: 640 }}')"></div>
              {%- endif -%}
              {{ c.settings.video | video_tag: autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '1600x' }}
            {%- else -%}
              <div class="reel__empty">
                <i class="reel__bars"></i>
                <span class="reel__slot label">{{ 'reel.slot' | t }} {{ forloop.index }} · {{ c.settings.title | escape }}</span>
              </div>
            {%- endif -%}
            {%- if bubbles.size > 0 -%}
              <div class="reel__fx">
                {%- for t in bubbles limit: 3 -%}
                  {%- assign tt = t | strip -%}
                  {%- if tt contains '"' or tt contains '«' -%}
                    <span class="bub bub--say bub--{{ forloop.index }}" data-bub>{{ tt | remove: '"' | remove: '«' | remove: '»' | strip | escape }}</span>
                  {%- elsif tt != blank -%}
                    <span class="bub bub--{{ forloop.index }}" data-bub>{{ tt | escape }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="reel__hud" aria-hidden="true">
        <i class="reel__c reel__c--tl"></i><i class="reel__c reel__c--tr"></i><i class="reel__c reel__c--bl"></i><i class="reel__c reel__c--br"></i>
        <span class="reel__rec"><i></i>REC</span>
        <span class="reel__tc" data-tc>00:00:00</span>
        <span class="reel__meta"><b data-place-out>{{ first.settings.place | escape }}</b><span data-date-out>{{ first.settings.date | escape }}</span></span>
        <span class="reel__bat"><i></i><i></i><i></i></span>
      </div>
      {%- for s in stickers -%}
        {%- if s.settings.image != blank -%}
          <span class="reel__stk" data-reel-stk style="--w: {{ s.settings.size }}px" {{ s.shopify_attributes }}>
            {{- s.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320,480,640', sizes: '(min-width: 990px) 260px, 34vw', alt: '', draggable: 'false' -}}
          </span>
        {%- endif -%}
      {%- endfor -%}
      <p class="reel__kicker label">{{ section.settings.kicker | escape }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a class="reel__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" data-reel-cta data-h>
          <b>{{ section.settings.cta_label | escape }}</b>
          {%- if section.settings.cta_note != blank -%}<span>{{ section.settings.cta_note | escape }}</span>{%- endif -%}
          <i aria-hidden="true">→</i>
        </a>
      {%- endif -%}
      {%- if section.settings.show_sound and has_video -%}
        <button class="reel__sound" type="button" data-sound aria-pressed="false" data-h>
          <i aria-hidden="true"></i><span data-label-off>{{ 'reel.sound_on' | t }}</span><span data-label-on hidden>{{ 'reel.sound_off' | t }}</span>
        </button>
      {%- endif -%}
    </div>
    {%- if clips.size > 1 -%}
      <div class="reel__chips">
        {%- for c in clips -%}
          <button class="reel__chip{% if forloop.first %} on{% endif %}" type="button" data-chip="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-h>
            <b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b><span>{{ c.settings.title | escape }}</span><i aria-hidden="true"></i>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.scroll_hint != blank -%}
      {%- assign hint = section.settings.scroll_hint | split: '' -%}
      <div class="reel__more" data-reel-more aria-hidden="true">
        <span class="reel__more-a"><i></i><i></i></span>
        <span class="reel__more-t">{%- for c in hint -%}{%- if c == ' ' -%}<i>&nbsp;</i>{%- else -%}<i style="--i: {{ forloop.index0 }}">{{ c | escape }}</i>{%- endif -%}{%- endfor -%}</span>
        <span class="reel__more-bar"><i></i></span>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Video del brand",
  "max_blocks": 14,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta", "default": "Girato da noi · nessun attore" },
    { "type": "text", "id": "title_1", "label": "Titolo dietro il video", "default": "La vera" },
    { "type": "text", "id": "title_2", "label": "Titolo dietro il video (contorno)", "default": "Team Butti" },
    { "type": "select", "id": "style", "label": "Sfondo", "default": "dark", "options": [
      { "value": "dark", "label": "Scuro" },
      { "value": "pink", "label": "Rosa poster" },
      { "value": "paper", "label": "Carta" }
    ] },
    { "type": "text", "id": "cta_label", "label": "Bottone shop (sempre visibile sul video)", "default": "Shop il drop" },
    { "type": "text", "id": "cta_note", "label": "Sotto il bottone", "default": "Pezzi limitati" },
    { "type": "url", "id": "cta_link", "label": "Link bottone", "info": "Vuoto = tutti i prodotti" },
    { "type": "text", "id": "scroll_hint", "label": "Scritta \"continua a scorrere\"", "info": "Compare quando il video è a tutto schermo, così si capisce che la pagina continua. Vuoto = nascosta.", "default": "Scorri giù · c'è il drop" },
    { "type": "range", "id": "length", "label": "Effetto zoom con lo scroll", "info": "100 = nessun effetto, il video è già a schermo intero. Più è basso, meno la pagina si ferma sul video.", "min": 100, "max": 300, "step": 10, "unit": "vh", "default": 130 },
    { "type": "range", "id": "autoplay_next", "label": "Passa alla clip successiva dopo", "info": "0 = mai", "min": 0, "max": 30, "step": 1, "unit": "s", "default": 9 },
    { "type": "checkbox", "id": "show_sound", "label": "Bottone audio", "default": true },
    { "type": "checkbox", "id": "show_without_video", "label": "Mostra anche senza video", "default": false, "info": "Di default la sezione resta nascosta sul negozio finché non carichi almeno un video." }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Clip",
      "limit": 6,
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "MP4 orizzontale o verticale (Reel). Max 20 MB consigliati, parte muto in loop." },
        { "type": "text", "id": "title", "label": "Titolo", "default": "Sterrato" },
        { "type": "text", "id": "place", "label": "Luogo (in sovrimpressione)", "default": "Chianni" },
        { "type": "text", "id": "date", "label": "Data (in sovrimpressione)", "default": "2026" },
        { "type": "text", "id": "bubbles", "label": "Fumetti", "info": "Fino a 3, separati da | . Escono uno dopo l'altro mentre gira la clip. Tra virgolette = frase detta da qualcuno.", "default": "Partita da Chianni.|Destinazione Milano." }
      ]
    },
    {
      "type": "sticker",
      "name": "Sticker sul video",
      "limit": 8,
      "settings": [
        { "type": "paragraph", "content": "Gli sticker compaiono uno alla volta, a turno, in un punto libero del video: mai sopra i fumetti, il REC, l'audio o il bottone Shop." },
        { "type": "image_picker", "id": "image", "label": "Sticker (PNG scontornato)" },
        { "type": "range", "id": "size", "label": "Larghezza", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 170 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video del brand",
      "blocks": [
        { "type": "clip", "settings": { "title": "La DeVille", "place": "Chianni", "date": "2026", "bubbles": "Partita da Chianni.|\"Fa paura.\"" } },
        { "type": "clip", "settings": { "title": "La targa", "place": "Milano", "date": "2026", "bubbles": "Il portatarga dice Los Angeles.|In gotico." } },
        { "type": "clip", "settings": { "title": "Milano", "place": "Milano", "date": "26.09.2026", "bubbles": "Destinazione Milano." } }
      ]
    }
  ]
}
{% endschema %}
