{%- comment -%} id="countdown": the hero's countdown button scrolls here {%- endcomment -%}
<section class="sec drop" id="countdown" data-tb="drop">
  <div class="drop__in">
    <div class="poster rv">
      <h2 class="poster__t d grunge">{{ section.settings.poster_title | escape | replace: '|', '<br>' }}</h2>
      <div class="poster__row">
        <span class="d">{{ section.settings.poster_date | escape | replace: '|', '<br>' }}</span>
        <div class="poster__info">{{ section.settings.poster_info }}</div>
        <span class="d poster__brand">Team<br>Butti<br>Merde</span>
      </div>
      {%- if section.settings.stamp != blank -%}<span class="stamp">{{ section.settings.stamp | escape }}</span>{%- endif -%}
    </div>
    <div class="rv">
      <p class="label">{{ section.settings.kicker | escape }}</p>
      <h2 class="sec__title d grunge">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.date != blank -%}
        <div class="count" data-countdown="{{ section.settings.date | escape }}">
          <div><b data-u="d">00</b><small>{{ 'countdown.days' | t }}</small></div>
          <div><b data-u="h">00</b><small>{{ 'countdown.hours' | t }}</small></div>
          <div><b data-u="m">00</b><small>{{ 'countdown.minutes' | t }}</small></div>
          <div><b data-u="s">00</b><small>{{ 'countdown.seconds' | t }}</small></div>
        </div>
      {%- endif -%}
      <p class="drop__txt">{{ section.settings.text | escape }}</p>
      {% render 'newsletter-form', form_id: 'DropNewsletter', tags: section.settings.tags, submit: section.settings.submit, success: section.settings.success %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Poster + countdown",
  "settings": [
    { "type": "text", "id": "poster_title", "label": "Titolo poster", "default": "Market|Veneto", "info": "Usa | per andare a capo" },
    { "type": "text", "id": "poster_date", "label": "Data poster", "default": "07.11|2026" },
    { "type": "richtext", "id": "poster_info", "label": "Info poster", "default": "<p>Luogo e orari in arrivo<br>Lascia la mail: ti avvisiamo noi</p>" },
    { "type": "text", "id": "stamp", "label": "Timbro", "default": "Gadget gratis" },
    { "type": "text", "id": "kicker", "label": "Etichetta", "default": "Prossima tappa" },
    { "type": "text", "id": "title", "label": "Titolo", "default": "Market Veneto" },
    { "type": "text", "id": "date", "label": "Data e ora (market o drop)", "info": "Formato 2026-11-07T10:00:00+01:00. È anche la data del bottone countdown nella hero.", "default": "2026-11-07T10:00:00+01:00" },
    { "type": "text", "id": "text", "label": "Testo", "default": "Lascia la mail: al market ti aspetta un gadget Team Butti gratis." },
    { "type": "header", "content": "Iscrizione" },
    { "type": "text", "id": "submit", "label": "Bottone", "default": "Voglio il gadget" },
    { "type": "text", "id": "success", "label": "Messaggio dopo l'iscrizione", "default": "Ci sei. Al market dì la tua mail al banco Team Butti e ritira il gadget." },
    { "type": "text", "id": "tags", "label": "Tag del cliente", "info": "In Clienti trovi chi si è iscritto da qui filtrando per questo tag", "default": "newsletter, market-veneto" }
  ],
  "presets": [{ "name": "Poster + countdown" }]
}
{% endschema %}
