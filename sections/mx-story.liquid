{%- comment -%}
  Brand story told by a motocross bike jumping the Tuscan dunes.
  Horizontal scroll: one chapter per screen; the terrain and the jumps are generated by theme.js,
  the jump physics depends only on the position, so scrolling back replays the same jump.
{%- endcomment -%}
{%- assign chapters = section.blocks | where: 'type', 'chapter' -%}
{%- if chapters.size > 0 -%}
<section class="mxs" id="storia-mx" data-tb="mxs" data-braap="{{ section.settings.braap | escape }}" style="height: {{ chapters.size | times: 110 | plus: 60 }}vh; --mx-plastic: {{ section.settings.plastic }}; --mx-jersey: {{ section.settings.jersey }}; --mx-pants: {{ section.settings.pants }}; --mx-helmet: {{ section.settings.helmet }}; --mxs-sky: {{ section.settings.sky }}; --mxs-dirt: {{ section.settings.dirt }};">
  <div class="mxs__s">
    <div class="mxs__sky" aria-hidden="true"><i class="mxs__sun"></i></div>
    <div class="mxs__far" data-mxs-far aria-hidden="true"></div>
    <div class="mxs__world" data-mxs-world style="width: calc({{ chapters.size }} * var(--chw) + 60vw)">
      <svg class="mxs__ground" data-mxs-ground aria-hidden="true" focusable="false"></svg>
      {%- for c in chapters -%}
        {%- liquid
          assign media = c.settings.video | default: c.settings.image
          assign fr = '4/3'
          if media != blank and media.aspect_ratio < 0.95
            assign fr = '4/5'
          elsif media != blank and media.aspect_ratio < 1.15
            assign fr = '1/1'
          endif
        -%}
        <article class="mxs__ch{% if media != blank %} mxs__ch--media{% endif %}" style="left: calc({{ forloop.index0 }} * var(--chw)); --fr: {{ fr }}" {{ c.shopify_attributes }}>
          <div class="mxs__txt">
            <p class="mxs__year d" aria-hidden="true">{{ c.settings.year | escape }}</p>
            <p class="label mxs__place">{{ forloop.index | prepend: '0' | slice: -2, 2 }} / {{ forloop.length | prepend: '0' | slice: -2, 2 }}{% if c.settings.place != blank %} — {{ c.settings.place | escape }}{% endif %}</p>
            <h3 class="mxs__t d">{{ c.settings.title | escape }}</h3>
            {%- if c.settings.text != blank -%}<p class="mxs__p">{{ c.settings.text | escape }}</p>{%- endif -%}
          </div>
          {%- if c.settings.video != blank -%}
            <figure class="mxs__pic"><div class="mxs__frame">{{ c.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '800x' }}</div><figcaption class="label">{{ c.settings.caption | escape }}</figcaption></figure>
          {%- elsif c.settings.image != blank -%}
            <figure class="mxs__pic"><div class="mxs__frame">{{ c.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 990px) 30vw, 60vw', alt: c.settings.title }}</div><figcaption class="label">{{ c.settings.caption | escape }}</figcaption></figure>
          {%- elsif request.design_mode -%}
            <figure class="mxs__pic mxs__pic--empty"><div class="mxs__frame"><span class="label">{{ 'mxs.photo' | t }}</span></div><figcaption class="label">{{ c.settings.caption | escape }}</figcaption></figure>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.bike_sprite != blank -%}
      {%- liquid
        assign bs = section.settings.bike_sprite
        assign ar = bs.aspect_ratio | times: section.settings.bike_rows | divided_by: section.settings.bike_cols
      -%}
      <div class="mxs__bike" data-mxs-bike style="transform-origin: 50% {{ section.settings.bike_ground }}%">
        <div class="mx mx--sprite" style="aspect-ratio: {{ ar }}">
          <div class="mx__sprite" data-bike-sprite data-frames="{{ section.settings.bike_frames }}" data-cols="{{ section.settings.bike_cols }}" data-rows="{{ section.settings.bike_rows }}" data-step="{{ section.settings.bike_step }}" data-ground="{{ section.settings.bike_ground }}" style="background-image: url('{{ bs | image_url: width: 4000 }}'); background-size: {{ section.settings.bike_cols | times: 100 }}% {{ section.settings.bike_rows | times: 100 }}%"></div>
        </div>
      </div>
    {%- elsif section.settings.bike_style == 'drawn' -%}
      <div class="mxs__bike" data-mxs-bike>{% render 'mx-bike', uid: section.id, num: section.settings.number %}</div>
    {%- else -%}
      <div class="mxs__bike mxs__bike--art" data-mxs-bike>{% render 'mx-bike-art' %}</div>
    {%- endif -%}
    <div class="mxs__head">
      <p class="label">{{ section.settings.kicker | escape }}</p>
      <h2 class="mxs__h d">{{ section.settings.title | escape }} <span class="out">{{ section.settings.title_outline | escape }}</span></h2>
    </div>
    <div class="mxs__bar" aria-hidden="true">
      {%- for c in chapters -%}<span>{{ c.settings.year | escape }}</span>{%- endfor -%}
      <i data-mxs-bar></i>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Storia in moto (cross)",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta", "default": "La storia · scorri e dai gas" },
    { "type": "text", "id": "title", "label": "Titolo", "default": "Da dove" },
    { "type": "text", "id": "title_outline", "label": "Titolo (contorno)", "default": "veniamo" },
    { "type": "text", "id": "braap", "label": "Scritta al decollo", "info": "Vuoto = nessuna scritta", "default": "BRAAAP!" },
    { "type": "header", "content": "Moto e pilota" },
    {
      "type": "select", "id": "bike_style", "label": "Moto", "default": "art",
      "options": [
        { "value": "art", "label": "Illustrata (Team Butti 69)" },
        { "value": "drawn", "label": "Disegnata (colori personalizzabili)" }
      ]
    },
    { "type": "paragraph", "content": "Numero e colori qui sotto valgono solo per la moto disegnata." },
    { "type": "text", "id": "number", "label": "Numero di gara", "default": "69" },
    { "type": "color", "id": "plastic", "label": "Plastiche", "default": "#FF2E93" },
    { "type": "color", "id": "jersey", "label": "Maglia", "default": "#141414" },
    { "type": "color", "id": "pants", "label": "Pantaloni", "default": "#141414" },
    { "type": "color", "id": "helmet", "label": "Casco", "default": "#F7F6F1" },
    { "type": "header", "content": "Moto a sprite animato (facoltativo)" },
    { "type": "paragraph", "content": "Sprite WebP trasparente fatto con tools/higgsfield/make-car-sprite.sh (vedi tools/higgsfield/README.md). Se c'è, prende il posto della moto scelta sopra." },
    { "type": "image_picker", "id": "bike_sprite", "label": "Sprite della moto" },
    { "type": "range", "id": "bike_cols", "label": "Colonne", "min": 1, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "bike_rows", "label": "Righe", "min": 1, "max": 8, "step": 1, "default": 4 },
    { "type": "number", "id": "bike_frames", "label": "Frame", "default": 24 },
    { "type": "range", "id": "bike_step", "label": "Pixel di pista per frame", "min": 4, "max": 40, "step": 1, "default": 10 },
    { "type": "range", "id": "bike_ground", "label": "Dove toccano le ruote (dall'alto)", "min": 70, "max": 100, "step": 1, "unit": "%", "default": 92 },
    { "type": "header", "content": "Paesaggio" },
    { "type": "color", "id": "sky", "label": "Cielo", "default": "#9EC9EF" },
    { "type": "color", "id": "dirt", "label": "Terra delle dune", "default": "#D2A55C" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Capitolo",
      "settings": [
        { "type": "text", "id": "year", "label": "Anno / data", "default": "2019" },
        { "type": "text", "id": "place", "label": "Luogo", "default": "Toscana" },
        { "type": "text", "id": "title", "label": "Titolo", "default": "Il primo due tempi" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "video", "id": "video", "label": "Oppure video (muto, in loop)" },
        { "type": "text", "id": "caption", "label": "Didascalia" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Storia in moto (cross)",
      "blocks": [
        { "type": "chapter", "settings": { "year": "2019", "place": "Toscana", "title": "Il primo due tempi", "text": "Un 125 preso a rate, uno sterrato dietro casa e una crew che cade più di quanto guida. Nasce tutto lì.", "caption": "Lo sterrato" } },
        { "type": "chapter", "settings": { "year": "2021", "place": "Toscana", "title": "Le prime maglie", "text": "Maglie da hockey e da cross disegnate per noi, venti pezzi stampati. Le chiedono gli amici, poi gli amici degli amici.", "caption": "Drop zero" } },
        { "type": "chapter", "settings": { "year": "2024", "place": "Ovunque", "title": "Team Butti Merde", "text": "Il nome diventa un coro. Poster rosa, leopardato, numeri sulla schiena: lo stile prende forma.", "caption": "La crew" } },
        { "type": "chapter", "settings": { "year": "26.09", "place": "Milano", "title": "Il Market", "text": "Piazzale Cantore 10: banchetti pieni, DJ set e la fila fuori. Dalla Toscana a Milano in Cadillac.", "caption": "Market Milano" } },
        { "type": "chapter", "settings": { "year": "Oggi", "place": "Drop 02", "title": "Gas aperto", "text": "Nuove maglie, nuovi colori, stessa crew. Il prossimo salto lo facciamo insieme.", "caption": "Drop 02" } }
      ]
    }
  ]
}
{% endschema %}
