<section class="sec">
  <div class="sec__head"><h1 class="sec__title d grunge">{{ 'collections.title' | t }}</h1></div>
  <div class="grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="card">
        <div class="card__m">
          {%- if collection.featured_image -%}
            {%- assign alt = collection.title | escape -%}
            <div class="flip flip--photo"><div>{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'card__img', widths: '400,600,800', sizes: '(min-width: 990px) 25vw, 50vw', alt: alt }}</div></div>
          {%- else -%}
            <div class="flip flip--photo"><div>{{ 'collection-1' | placeholder_svg_tag: 'card__ph' }}</div></div>
          {%- endif -%}
        </div>
        <div class="card__i"><b>{{ collection.title | escape }}</b><span>{{ collection.products_count }}</span></div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Elenco collezioni", "settings": [] }
{% endschema %}
