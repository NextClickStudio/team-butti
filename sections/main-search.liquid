<section class="sec" data-tb="grid">
  <div class="sec__head"><h1 class="sec__title d grunge">{{ 'general.search' | t }}</h1></div>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="hidden" name="type" value="product">
    <div class="nl">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
      <button type="submit"><span>{{ 'general.search' | t }}</span></button>
    </div>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="label search-count">{{ 'search.count' | t: count: search.results_count }}</p>
      {%- if search.results_count > 0 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="empty-msg">{{ 'search.none' | t }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination: next: '→', previous: '←' }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Ricerca", "settings": [] }
{% endschema %}
