{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = collections['all']
  endif
-%}
<section class="sec" data-tb="grid">
  <div class="sec__head rv">
    {%- assign dt = '' -%}{%- if coll != blank -%}{%- capture dt -%}{% render 'drop-title', c: coll %}{%- endcapture -%}{%- endif -%}
    {%- if dt contains 'class="dt' -%}<h2 class="sec__title d">{{ dt }}</h2>{%- else -%}<h2 class="sec__title d grunge">{{ section.settings.title | escape }} <span class="out">{{ section.settings.title_outline | escape }}</span></h2>{%- endif -%}
    {%- if section.settings.show_tabs -%}
      <div class="tabs" data-tabs>
        <button type="button" class="tab on" data-f="all">{{ 'collections.all' | t }}</button>
        {%- if coll != blank -%}
          {%- for t in coll.all_types -%}
            {%- if t != blank -%}<button type="button" class="tab" data-f="{{ t | handleize }}">{{ t | escape }}</button>{%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <button type="button" class="tab" data-f="hockey">Hockey</button><button type="button" class="tab" data-f="mx">Motocross</button><button type="button" class="tab" data-f="football">Football</button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <div class="grid">
    {%- if coll != blank and coll.products_count > 0 -%}
      {%- comment -%} with the type filters every piece is rendered: "Tutto" shows the first N, a type shows all of its pieces (e.g. every sold out long sleeve) {%- endcomment -%}
      {%- liquid
        assign shown = section.settings.limit
        if section.settings.show_tabs
          assign shown = 50
        endif
      -%}
      {%- for product in coll.products limit: shown -%}
        {%- liquid
          assign more = false
          if forloop.index > section.settings.limit
            assign more = true
          endif
        -%}
        {% render 'product-card', product: product, more: more %}
      {%- endfor -%}
    {%- elsif section.settings.collection != blank and request.design_mode == false -%}
      {%- comment -%} the drop is announced but its pieces are not online yet {%- endcomment -%}
      <div class="soon">
        <span class="soon__k label">{{ section.settings.soon_kicker | escape }}</span>
        <b class="soon__t d grunge">{{ section.settings.soon_title | escape }}</b>
        {%- if section.settings.soon_text != blank -%}<p class="soon__p">{{ section.settings.soon_text | escape }}</p>{%- endif -%}
      </div>
    {%- else -%}
      {% render 'demo-cards', limit: section.settings.limit %}
    {%- endif -%}
  </div>
  {%- liquid
    assign arch = section.settings.archive_collection
    assign show_more = false
    if coll != blank and section.settings.link_label != blank and coll.products_count > 0
      assign show_more = true
    endif
  -%}
  {%- if show_more or arch != blank -%}
    <div class="sec__more">
      {%- if show_more -%}<a href="{{ coll.url }}" class="btn">{{ section.settings.link_label | escape }}</a>{%- endif -%}
      {%- if arch != blank -%}
        {%- capture at -%}{% render 'drop-title', c: arch, small: true %}{%- endcapture -%}
        <a href="{{ arch.url }}" class="btn btn--ghost arch-btn arch-btn--bin" data-h>{% render 'mini-bin' %}<span class="arch-btn__t">{%- if at contains 'class="dt' -%}{{ 'collections.archive' | t }} · {{ at }}{%- else -%}{{ section.settings.archive_label | default: arch.title | escape }}{%- endif -%}</span></a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Griglia drop",
  "settings": [
    { "type": "text", "id": "title", "label": "Titolo", "default": "Drop" },
    { "type": "text", "id": "title_outline", "label": "Titolo (contorno)", "default": "01" },
    { "type": "collection", "id": "collection", "label": "Collezione", "info": "Vuota = tutti i prodotti del negozio (maglie demo se il negozio non ha ancora prodotti)" },
    { "type": "range", "id": "limit", "label": "Prodotti", "info": "Quanti se ne vedono su Tutto. Con i filtri per tipo, ogni tipo mostra tutti i suoi pezzi.", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_tabs", "label": "Filtri per tipo prodotto", "default": true },
    { "type": "text", "id": "link_label", "label": "Bottone collezione", "default": "Vedi tutto" },
    { "type": "header", "content": "Archivio" },
    { "type": "collection", "id": "archive_collection", "label": "Collezione archivio", "info": "Il drop precedente (es. Drop Hotmilf): sotto la griglia compare il bottone per andarci." },
    { "type": "text", "id": "archive_label", "label": "Bottone archivio", "default": "Archivio · Drop Hotmilf" },
    { "type": "header", "content": "Prima del drop" },
    { "type": "paragraph", "content": "Si vede quando la collezione scelta non ha ancora prodotti online." },
    { "type": "text", "id": "soon_kicker", "label": "Sopra il titolo", "default": "Prossimo drop" },
    { "type": "text", "id": "soon_title", "label": "Titolo", "default": "In arrivo" },
    { "type": "text", "id": "soon_text", "label": "Testo", "default": "Domenica si apre. Tieni d'occhio Instagram." }
  ],
  "presets": [{ "name": "Griglia drop" }]
}
{% endschema %}
