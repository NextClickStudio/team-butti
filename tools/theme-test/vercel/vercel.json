{
  "rewrites": [
    { "source": "/v/:sha/:path*", "destination": "/api/v?sha=:sha&path=:path*" },
    { "source": "/lib/liquid.js", "destination": "https://cdn.jsdelivr.net/npm/liquidjs@10.30.0/dist/liquid.browser.min.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
    ] },
    { "source": "/((?!v/|lib/).*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
