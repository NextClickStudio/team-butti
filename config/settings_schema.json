      },
      {
        "type": "text",
        "id": "shop_pill_label",
        "label": "Testo bottone Shop",
        "default": "Shop il drop"
      },
      {
        "type": "url",
        "id": "shop_pill_link",
        "label": "Link bottone Shop",
