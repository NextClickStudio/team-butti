  {
    "name": "Maglie",
    "settings": [
      {
        "type": "select",
        "id": "product_image_fit",
        "label": "Foto prodotto",
        "default": "contain",
        "options": [
          {
            "value": "contain",
            "label": "Intere su colore (still life scontornate)"
          },
          {
            "value": "cover",
            "label": "A tutto riquadro (foto ambientate)"
          }
        ],
        "info": "Con le still life la maglia resta intera e la card prende il colore del tag bg: (es. bg:ffd400)."
      },
      {
        "type": "select",
        "id": "jersey_style",
        "label": "Stile disegno maglie",
        "default": "flat",
        "options": [
          {
            "value": "flat",
            "label": "Flat (concept approvato)"
          },
          {
            "value": "detailed",
            "label": "Dettagliato (cuciture, mesh, gruccia)"
          }
        ],
        "info": "Usato finché un prodotto non ha foto. Disegno da metafield custom.jersey_type / jersey_colors / jersey_number o dai tag jersey:hockey, colors:ff2e93-0d0d0d-f4f1ea-0d0d0d, num:69, bg:ffd400."
      }
    ]
  },
  {
    "name": "Effetti",
    "settings": [
      {
        "type": "checkbox",
        "id": "loader",
        "label": "Loader contagiri all'apertura",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "custom_cursor",
        "label": "Cursore personalizzato (desktop)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "grain",
        "label": "Grana pellicola",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_transitions",
        "label": "Transizione tra le pagine",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "magnetic_buttons",
        "label": "Bottoni magnetici",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "split_titles",
        "label": "Titoli animati lettera per lettera",
        "default": true
