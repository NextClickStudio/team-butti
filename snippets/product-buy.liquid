{%- comment -%}
  Buy box of the product page and the quick view: size picker + add to bag.
  Tag "modello:M" adds "the model is 1,80 m tall and wears M" (height in Theme settings > Maglie).
  Accepts: product
{%- endcomment -%}
{%- liquid
  assign model_size = ''
  for tag in product.tags
    if tag contains 'modello:'
      assign model_size = tag | remove: 'modello:' | strip
    endif
  endfor
-%}
{% render 'product-form', product: product %}
{%- if model_size != blank and settings.model_height != blank -%}
  <p class="pdp__fit">{{ 'products.model' | t: height: settings.model_height, size: model_size }}</p>
{%- endif -%}
