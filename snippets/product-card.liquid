{%- comment -%}
  Product card. Photos: front = featured image, back = 2nd image (flips on hover).
  No photos: jersey illustration from metafields custom.jersey_type / jersey_colors / jersey_number.
  Accepts: product, bg (optional; default metafield custom.card_bg), more (optional: hidden until a type filter of the grid shows it),
  archive (optional: a past drop, the card opens the product page so the visit is counted, and the click is published as an analytics event).
  Tag in-arrivo: the piece is shown but not on sale yet (stamp "In arrivo" instead of "Sold out").
{%- endcomment -%}
{%- liquid
  assign img1 = product.featured_image
  assign img2 = product.images[1]
  assign jtype = product.metafields.custom.jersey_type.value
  assign jcolors = product.metafields.custom.jersey_colors.value
  assign jnum = product.metafields.custom.jersey_number.value
  assign card_bg = bg | default: product.metafields.custom.card_bg.value
  assign jtags = product.tags | join: '|'
  assign has_art = false
  if jtype != blank or jtags contains 'jersey:'
    assign has_art = true
  endif
  assign alt = product.title | escape
  assign soon = false
  if product.tags contains 'in-arrivo'
    assign soon = true
  endif
  assign badge = ''
  for tag in product.tags
    if tag contains 'badge:' and badge == blank
      assign badge = tag | remove: 'badge:'
    endif
    if tag contains 'bg:' and card_bg == blank
      assign card_bg = tag | remove: 'bg:' | strip | prepend: '#' | replace: '##', '#'
    endif
  endfor
-%}
<a href="{{ product.url }}" class="card{% unless product.available %} sold{% endunless %}{% if img1 and img2 == blank %} card--single{% endif %}" data-type="{{ product.type | handleize }}"{% if more %} data-more{% endif %}{% if archive %} data-arch="{{ product.handle | escape }}" data-arch-title="{{ product.title | escape }}"{% else %} data-quick="{{ product.url }}"{% endif %} data-h>
  <div class="card__m"{% if card_bg != blank %} style="background:{{ card_bg | escape }}"{% endif %}>
    {%- if badge != blank and product.available -%}<span class="card__tag">{{ badge | escape }}</span>{%- endif -%}
    {%- if img1 -%}
      <div class="flip flip--photo">
        <div>{{ img1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'card__img', alt: alt }}</div>
        {%- if img2 -%}
          <div>{{ img2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'card__img', alt: alt }}</div>
        {%- endif -%}
      </div>
    {%- elsif has_art -%}
      <div class="hang" data-swing>
        <div class="flip">
          <div>{% render 'jersey-art', type: jtype, colors: jcolors, num: jnum, tags: jtags, hanger: true, capt: true %}</div>
          <div>{% render 'jersey-art', type: jtype, colors: jcolors, num: jnum, tags: jtags, side: 'back', hanger: true %}</div>
        </div>
      </div>
    {%- else -%}
      <div class="flip flip--photo"><div>{{ 'product-apparel-1' | placeholder_svg_tag: 'card__ph' }}</div></div>
    {%- endif -%}
    <span class="glare"></span>
    {%- if product.available -%}
      <span class="card__quick">{{ 'products.card_cta' | t }}</span>
    {%- else -%}
      <span class="stamp{% if soon %} stamp--soon{% endif %}">{% if soon %}{{ 'products.soon' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
    {%- endif -%}
  </div>
  <div class="card__i"><b>{{ product.title | escape }}</b>{% render 'price', product: product %}</div>
</a>
