{%- comment -%} Variant picker + add to cart. Accepts: product {%- endcomment -%}
{%- assign current = product.selected_or_first_available_variant -%}
<div class="pform" data-pform>
  <script type="application/json" data-variants>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"available":{{ v.available | json }},"options":{{ v.options | json }},"price":{{ v.price | money | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
  {%- unless product.has_only_default_variant -%}
    {%- for option in product.options_with_values -%}
      <div class="pform__opt" data-opt>
        <p class="label">{{ option.name | escape }}</p>
        <div class="sizes">
          {%- for value in option.values -%}
            <button type="button" class="size{% if value.selected %} on{% endif %}{% unless value.available %} na{% endunless %}" data-v="{{ value | escape }}">{{ value | escape }}</button>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  {%- endunless -%}
  {%- form 'product', product, class: 'pform__form', data-product-form: '' -%}
    <input type="hidden" name="id" value="{{ current.id }}">
    <button type="submit" name="add" class="btn btn--pink btn--block" data-add {% unless current.available %}disabled{% endunless %}>
      {%- if current.available -%}{{ 'products.add' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
    </button>
    <p class="form-error" data-error hidden></p>
  {%- endform -%}
</div>
