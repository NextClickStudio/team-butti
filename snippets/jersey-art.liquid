{%- comment -%}
  Renders a jersey illustration (drawn client-side by assets/tb-jersey.js).
  Accepts: type, colors ("base,sleeve,trim,text"), side, num, name, hanger, capt, class, tags ("tag1|tag2", fallback for type/colors/num)
{%- endcomment -%}
<div
  class="jart {{ class }}"
  data-tb-jersey="{{ type | escape }}"
  data-colors="{{ colors | escape }}"
  data-tags="{{ tags | escape }}"
  data-side="{{ side | default: 'front' }}"
  data-num="{{ num | escape }}"
  data-name="{{ name | default: 'BUTTI' | escape }}"
  data-hanger="{{ hanger | default: false }}"
  data-capt="{{ capt | default: false }}"
></div>
