    "storia_mx": {
      "type": "mx-story",
      "blocks": {
        "ch1": {
          "type": "chapter",
          "settings": {
            "year": "Prima",
            "place": "Valdera",
            "title": "Gli amici",
            "text": "Prima c'erano gli amici. Uno sterrato dietro casa, un due tempi che va spinto più che guidato e nessun piano. Nessuno sapeva ancora cosa sarebbe diventato.",
            "video": "shopify://files/videos/tb-mx-spinta.mp4",
            "caption": "Valdera · 06.08.2025"
          }
        },
        "ch2": {
          "type": "chapter",
          "settings": {
            "year": "Poi",
            "place": "Nel grano",
            "title": "Il nome",
            "text": "Poi è arrivato il nome. TEAM BUTTI sulla schiena, su maglie da cross, da hockey e da football. Le chiedono gli amici, poi gli amici degli amici.",
            "image": "shopify://shop_images/tb-mx-maglie.jpg",
            "caption": "Due tempi nel grano"
          }
        },
        "ch3": {
          "type": "chapter",
          "settings": {
            "year": "Qui",
            "place": "L'officina",
            "title": "L'officina",
            "text": "Un'officina dove ci si trova, si parla, si prova, si inventa. Moto, maglie, una Cadillac leopardata: qui le cose partono senza sapere cosa diventeranno.",
            "image": "shopify://shop_images/tb-mx-officina.jpg",
            "caption": "La crew e la DeVille"
          }
        },
        "ch4": {
          "type": "chapter",
          "settings": {
            "year": "26.09",
            "place": "Milano",
            "title": "Fuori posto",
            "text": "Non è questione di andare lontano: è non stare dove ci si aspetta. Il pick-up col cofano arancione in mezzo a Milano, le maglie da cross al Market di Piazzale Cantore 10.",
            "image": "shopify://shop_images/tb-mx-pickup-milano.jpg",
            "caption": "Big ahh truck around Milano"
          }
        },
        "ch5": {
          "type": "chapter",
          "settings": {
            "year": "Oggi",
            "place": "In movimento",
            "title": "Gas aperto",
            "text": "Moto, vestiti, oggetti, persone, esperienze: se ci piace, ci entra. Senza un'unica direzione. Team Butti è un nome, il resto è in movimento.",
            "video": "shopify://files/videos/tb-mx-via.mp4",
            "caption": "Via! · 29.08.2026"
          }
        }
      },
      "block_order": [
        "ch1",
